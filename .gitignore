# ---------------------------------------------------------------------------
# Workcrest repository ignore rules
# Keep example configuration files, source migrations, and generated API
# contracts versioned. Keep credentials, runtime data, and build output local.
# ---------------------------------------------------------------------------

# Environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Node.js and package managers
node_modules/
.pnp
.pnp.*
.yarn/cache/
.yarn/install-state.gz
.yarn/unplugged/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js and frontend builds
.next/
out/
build/
dist/
.turbo/
.vercel/
.swc/
next-env.d.ts
*.tsbuildinfo
.eslintcache

# Python bytecode, packaging, and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/
sdist/
develop-eggs/
parts/
var/
share/python-wheels/
.installed.cfg
MANIFEST
.venv/
venv/
env/
ENV/
.python-version

# Django runtime data
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.db
backend/media/
backend/staticfiles/
media/
staticfiles/
uploads/
local_settings.py

# Celery and local services
celerybeat-schedule
celerybeat.pid
*.pid
postgres_data/
redis_data/
docker-compose.override.yml

# Tests, coverage, and analysis caches
coverage/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.pytest_tmp*/
backend/.pytest_cache/
backend/pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
test-results/
playwright-report/
blob-report/
*.lcov

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# IDE and editor settings
.idea/
.vscode/
*.code-workspace
.fleet/

# Operating-system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
