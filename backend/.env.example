DEBUG=true
SECRET_KEY=replace-me
DATABASE_URL=postgresql://workcrest_runtime:workcrest-runtime@localhost:5432/workcrest
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=false
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,.workcrest.local,.onrender.com
PLATFORM_DOMAIN=workcrest.local
PLATFORM_NAME=Workcrest
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://*.workcrest.local:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
# Production example: .your-platform-domain.com
SESSION_COOKIE_DOMAIN=
MEDIA_STORAGE_BACKEND=local
MEDIA_URL=/media/
# Supabase Storage / S3-compatible media settings for hosted deployments:
# MEDIA_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=workcrest-media
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=auto
# AWS_S3_ADDRESSING_STYLE=path
# AWS_QUERYSTRING_AUTH=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@workcrest.local
SENTRY_DSN=
